// Firebase Spark: deploy this as Cloud Firestore rules before real testing.
// Authenticated users can access only their own 15 supported module documents.
// No anonymous reads, no cross-user reads, no deletes, no Admin key in browser.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validModule() {
      return request.resource.data.keys().hasAll(['raw', 'revision', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['raw', 'revision', 'updatedAt'])
        && request.resource.data.raw is string
        && request.resource.data.raw.size() <= 850000
        && request.resource.data.revision is int
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/modules/{moduleId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validModule()
        && request.resource.data.revision == 1;
      allow update: if owns(uid) && validModule()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    // Per-record data for the separate study-desk IndexedDB namespace.
    match /users/{uid}/desk/{recordId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validModule()
        && request.resource.data.revision == 1;
      allow update: if owns(uid) && validModule()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{any=**} {
      allow read, write: if false;
    }
  }
}
